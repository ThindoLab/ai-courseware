{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "param-visual content",
  "type": "object",
  "required": ["title", "params", "formulas", "conclusionTemplate"],
  "properties": {
    "title": { "type": "string" },
    "grade": { "type": "string" },
    "params": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "min", "max", "step", "value"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number" },
          "value": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expr"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "expr": { "type": "string" }
        }
      }
    },
    "visual": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "icon-grid | bar | pie | rect" },
        "mapping": { "type": "object", "description": "icon-grid: varId -> emoji" },
        "value": { "description": "bar/pie: varId 或数字" },
        "max": { "description": "bar/pie: varId 或数字" },
        "width": { "description": "rect: varId 或数字" },
        "height": { "description": "rect: varId 或数字" },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "unit": { "type": "string" },
        "scale": { "type": "number" },
        "svg": { "type": "string", "description": "diagram: Agent 写的 SVG，可用 {{var}} 占位，模板注入实时值" }
      }
    },
    "validateCounts": { "type": "boolean", "description": "计数类为 true：formula 非非负整数时提示无解" },
    "noSolutionMessage": { "type": "string", "description": "无解时提示文案（默认通用）" },
    "conclusionTemplate": { "type": "string" },
    "hints": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "properties": {
        "refs": { "type": "array" },
        "module": { "type": "string" }
      }
    }
  }
}
